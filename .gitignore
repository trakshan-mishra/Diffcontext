# Secrets — API keys belong in the environment or an untracked .env, never in
# a tracked file (a pasted key gets committed and must then be rotated).
.env
.env.*
*.key

# Tooling caches
.mypy_cache/
.ruff_cache/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.egg
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environments
.venv/
venv/
node_modules/

# DiffContext runtime caches (content-addressed, regenerated on demand)
.diffcontext_cache.db
.diffcontext_cache.db-shm
.diffcontext_cache.db-wal
state.json
diffcontext_state.json

# Benchmark working data (regenerate: python benchmarks/eval_v2_hardened.py)
benchmark_repos/
benchmarks/results/
benchmarks/downstream/results/
benchmark_results.json
DiffContext_Status_Summary.pdf
sweep.log

# Semantic eval corpora: bulk data is regenerable from the scripts, and each
# directory's manifest (kept in git) records the params/seed that produced it.
# embeddings/ is a multi-GB vector cache built on a GPU — never commit it.
benchmarks/semantic/embeddings/
benchmarks/semantic/results/
benchmarks/semantic/pairs/*.jsonl
benchmarks/semantic/gap/*.jsonl
benchmarks/semantic/audit/*.csv

# Private working notes — call prep, positioning, application drafts.
# Never publish these.
writing/
notes/

# Local editor/agent configuration.
.claude/

# Cloudflare Pages deploy cache (written by `wrangler pages deploy`).
.wrangler/
